<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Protocolo HPK</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Syne:wght@700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root{--h:#D85A30;--p:#7F77DD;--k:#1D9E75;--bg:#0E0E10;--bg2:#161618;--bg3:#1E1E21;--border:rgba(255,255,255,0.07);--text:#F0EFE8;--muted:#6B6B72;--score:#F5A623}
*{margin:0;padding:0;box-sizing:border-box}
body{background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;font-weight:300;min-height:100vh;overflow-x:hidden}
#loading{position:fixed;inset:0;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:100;transition:opacity 0.6s ease}
#loading.hide{opacity:0;pointer-events:none}
.loading-logo{font-family:'Syne',sans-serif;font-size:13px;font-weight:700;letter-spacing:0.25em;color:var(--muted);text-transform:uppercase;margin-bottom:32px}
.loading-bar-wrap{width:120px;height:1px;background:var(--border);overflow:hidden}
.loading-bar{height:100%;background:var(--score);animation:loadbar 1.4s ease forwards}
@keyframes loadbar{from{width:0}to{width:100%}}
#app{max-width:420px;margin:0 auto;padding:0 0 60px;opacity:0;transform:translateY(16px);transition:opacity 0.5s ease,transform 0.5s ease}
#app.visible{opacity:1;transform:translateY(0)}
.header{padding:32px 20px 24px;border-bottom:1px solid var(--border);position:relative}
.header-eyebrow{font-family:'DM Mono',monospace;font-size:10px;color:var(--muted);letter-spacing:0.2em;text-transform:uppercase;margin-bottom:8px}
.header-title{font-family:'Syne',sans-serif;font-size:26px;font-weight:800;line-height:1.1}
.header-title span{color:var(--score)}
.header-right{position:absolute;top:32px;right:20px;text-align:right}
.badge{display:inline-block;font-family:'DM Mono',monospace;font-size:9px;font-weight:500;letter-spacing:0.12em;text-transform:uppercase;padding:5px 10px;border-radius:20px;background:rgba(29,158,117,0.15);color:var(--k);border:1px solid rgba(29,158,117,0.3)}
.header-sub{font-size:11px;color:var(--muted);margin-top:6px;font-family:'DM Mono',monospace}
.metrics{display:grid;grid-template-columns:1fr 1fr 1fr;gap:1px;background:var(--border);border-bottom:1px solid var(--border)}
.metric{background:var(--bg);padding:20px 16px;text-align:center}
.metric-label{font-family:'DM Mono',monospace;font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:0.15em;margin-bottom:8px}
.metric-value{font-family:'Syne',sans-serif;font-size:30px;font-weight:800;line-height:1}
.metric-value.sc{color:var(--score)}
.metric-sub{font-size:10px;color:var(--muted);margin-top:4px;font-family:'DM Mono',monospace}
.metric-sub.up{color:var(--k)}.metric-sub.dn{color:var(--h)}
.card{margin:16px 16px 0;background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:20px}
.card-title{font-family:'DM Mono',monospace;font-size:10px;font-weight:500;color:var(--muted);text-transform:uppercase;letter-spacing:0.18em;margin-bottom:20px}
.ya-card{margin:16px 16px 0;background:rgba(29,158,117,0.06);border:1px solid rgba(29,158,117,0.2);border-radius:12px;padding:20px;text-align:center}
.ya-card p{color:var(--k);font-size:13px;font-weight:500;margin-bottom:4px}
.ya-card span{color:var(--muted);font-size:11px;font-family:'DM Mono',monospace}
.sl-row{display:flex;align-items:center;gap:12px;margin-bottom:16px}
.sl-label{font-family:'DM Mono',monospace;font-size:10px;color:var(--muted);width:72px;flex-shrink:0;text-transform:uppercase;letter-spacing:0.08em}
.sl-row input[type=range]{flex:1;-webkit-appearance:none;height:2px;background:var(--bg3);border-radius:1px;outline:none}
.sl-row input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:16px;height:16px;border-radius:50%;background:var(--text);cursor:pointer;border:2px solid var(--bg);box-shadow:0 0 0 1px var(--border)}
.sl-val{font-family:'Syne',sans-serif;font-size:15px;font-weight:700;width:16px;text-align:right}
.toggle-section{margin-top:20px;padding-top:20px;border-top:1px solid var(--border)}
.num-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
.num-label{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--text)}
.dot{width:6px;height:6px;border-radius:50%;flex-shrink:0}
.num-input{width:64px;background:var(--bg3);border:1px solid var(--border);border-radius:6px;padding:6px 10px;color:var(--text);font-family:'Syne',sans-serif;font-size:14px;font-weight:700;text-align:center;outline:none}
.num-input:focus{border-color:var(--score)}
.tog-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
.tog-row:last-child{margin-bottom:0}
.tog-info{display:flex;align-items:center;gap:10px}
.tog-name{font-size:12px;color:var(--text)}
.tog-sub{font-size:10px;color:var(--muted);font-family:'DM Mono',monospace;margin-top:1px}
.switch{position:relative;width:40px;height:22px;flex-shrink:0}
.switch input{opacity:0;width:0;height:0}
.sw-track{position:absolute;inset:0;background:var(--bg3);border:1px solid var(--border);border-radius:11px;cursor:pointer;transition:background 0.2s,border-color 0.2s}
.sw-track:before{content:'';position:absolute;width:14px;height:14px;left:3px;top:3px;background:var(--muted);border-radius:50%;transition:transform 0.2s,background 0.2s}
input:checked+.sw-track{background:rgba(29,158,117,0.2);border-color:var(--k)}
input:checked+.sw-track:before{transform:translateX(18px);background:var(--k)}
.btn-save{width:100%;margin-top:20px;padding:14px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;color:var(--text);font-family:'Syne',sans-serif;font-size:13px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;cursor:pointer;transition:all 0.2s}
.btn-save:hover{background:rgba(245,166,35,0.08);border-color:rgba(245,166,35,0.3)}
.btn-save.ok{background:rgba(29,158,117,0.12);border-color:var(--k);color:var(--k)}
.btn-save:disabled{opacity:0.4;cursor:not-allowed}
.eje-row{display:flex;align-items:center;gap:12px;margin-bottom:16px}
.eje-row:last-child{margin-bottom:0}
.eje-letter{font-family:'Syne',sans-serif;font-size:13px;font-weight:800;width:14px;flex-shrink:0}
.eje-body{flex:1}
.eje-head{display:flex;justify-content:space-between;margin-bottom:6px}
.eje-name{font-size:11px;color:var(--muted);font-family:'DM Mono',monospace;text-transform:uppercase;letter-spacing:0.08em}
.eje-pct{font-family:'Syne',sans-serif;font-size:12px;font-weight:700}
.eje-track{height:2px;background:var(--bg3);border-radius:1px;overflow:hidden}
.eje-fill{height:100%;border-radius:1px;transition:width 0.5s ease}
.proto-item{display:flex;gap:14px;padding:12px 0;border-bottom:1px solid var(--border)}
.proto-item:last-child{border-bottom:none;padding-bottom:0}
.proto-dot{width:6px;height:6px;border-radius:50%;margin-top:6px;flex-shrink:0}
.proto-name{font-size:13px;font-weight:500;margin-bottom:3px}
.proto-why{font-size:11px;color:var(--muted);font-family:'DM Mono',monospace;line-height:1.6}
.chart-wrap{margin-top:20px;padding-top:18px;border-top:1px solid var(--border)}
.chart-eyebrow{font-family:'DM Mono',monospace;font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:0.15em;margin-bottom:10px}
.chart-bars{display:flex;align-items:flex-end;gap:4px;height:52px}
.chart-bar{flex:1;border-radius:2px 2px 0 0;min-height:2px}
.chart-dates{display:flex;gap:4px;margin-top:5px}
.chart-date{flex:1;font-family:'DM Mono',monospace;font-size:8px;color:var(--muted);text-align:center}
.toast{position:fixed;bottom:28px;left:50%;transform:translateX(-50%) translateY(20px);background:var(--bg2);border:1px solid var(--border);color:var(--text);padding:12px 24px;border-radius:24px;font-family:'DM Mono',monospace;font-size:12px;opacity:0;transition:opacity 0.3s,transform 0.3s;pointer-events:none;z-index:99}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
.toast.ok{border-color:rgba(29,158,117,0.4);color:var(--k)}
.toast.err{border-color:rgba(216,90,48,0.4);color:var(--h)}
</style>
</head>
<body>
<div id="loading">
  <div class="loading-logo">Protocolo HPK</div>
  <div class="loading-bar-wrap"><div class="loading-bar"></div></div>
</div>
<div id="app"><div id="root"></div></div>
<div class="toast" id="toast"></div>
<script>
var CH="#D85A30",CP="#7F77DD",CK="#1D9E75",CS="#F5A623";
var estado={};

window.addEventListener("load",function(){
  google.script.run
    .withSuccessHandler(function(data){
      estado=data;
      render();
      setTimeout(function(){
        document.getElementById("loading").classList.add("hide");
        document.getElementById("app").classList.add("visible");
      },1200);
    })
    .withFailureHandler(function(err){
      document.getElementById("root").innerHTML='<div style="padding:40px 20px;text-align:center;color:#6B6B72;font-family:monospace;font-size:12px">Error al conectar.<br><br><button onclick="location.reload()" style="background:none;border:1px solid #333;color:#999;padding:8px 16px;border-radius:6px;cursor:pointer;font-family:inherit">Reintentar</button></div>';
      document.getElementById("loading").classList.add("hide");
      document.getElementById("app").classList.add("visible");
    })
    .getEstado();
});

function render(){
  var dia=estado.dia||1,fase=estado.fase||"Activacion",durFase=estado.durFase||28;
  var racha=estado.racha||0,ultimoScore=estado.ultimoScore,tendencia=estado.tendencia;
  var yaRegistroHoy=estado.yaRegistroHoy||false,historial=estado.historial||[];
  var durSem=Math.ceil(durFase/7);
  var scoreDisplay=(ultimoScore!==null&&ultimoScore!==undefined)?ultimoScore:"--";
  var tendDisplay=(tendencia!==null&&tendencia!==undefined)?((tendencia>0?"+":"")+tendencia):"--";
  var tendClass=tendencia>0?"up":tendencia<0?"dn":"";
  var ult=historial.length?historial[historial.length-1]:null;
  var ejH=ult?Math.min(Math.round(ult.eje_h*10),100):0;
  var ejP=ult?Math.min(Math.round(ult.eje_p*10),100):0;
  var ejK=ult?Math.min(Math.round(ult.eje_k*10),100):0;

  document.getElementById("root").innerHTML=
  '<div class="header">'+
    '<div class="header-eyebrow">Protocolo HPK</div>'+
    '<div class="header-title">Dia <span>'+dia+'</span> - '+fase+'</div>'+
    '<div class="header-right">'+
      '<div class="badge">'+fase+'</div>'+
      '<div class="header-sub">Sem '+Math.ceil(dia/7)+' / '+durSem+'</div>'+
    '</div>'+
  '</div>'+
  '<div class="metrics">'+
    '<div class="metric"><div class="metric-label">Score</div><div class="metric-value sc" id="score-live">'+scoreDisplay+'</div><div class="metric-sub">hoy</div></div>'+
    '<div class="metric"><div class="metric-label">Racha</div><div class="metric-value">'+racha+'<span style="font-size:14px;color:var(--muted)">d</span></div><div class="metric-sub">consecutivos</div></div>'+
    '<div class="metric"><div class="metric-label">Tendencia</div><div class="metric-value">'+tendDisplay+'</div><div class="metric-sub '+tendClass+'">vs ayer</div></div>'+
  '</div>'+
  (yaRegistroHoy?
    '<div class="ya-card"><p>Registro de hoy guardado</p><span>Inmutable. Volve manana.</span></div>'
  :
    '<div class="card">'+
      '<div class="card-title">Registrar ahora</div>'+
      '<div class="sl-row"><span class="sl-label">Energia</span><input type="range" min="1" max="10" value="7" step="1" id="sl-e" oninput="live()"><span class="sl-val" id="v-e">7</span></div>'+
      '<div class="sl-row"><span class="sl-label">Foco</span><input type="range" min="1" max="10" value="7" step="1" id="sl-f" oninput="live()"><span class="sl-val" id="v-f">7</span></div>'+
      '<div class="sl-row"><span class="sl-label">Humor</span><input type="range" min="1" max="10" value="7" step="1" id="sl-h" oninput="live()"><span class="sl-val" id="v-h">7</span></div>'+
      '<div class="sl-row"><span class="sl-label">Sueno h</span><input type="range" min="3" max="10" value="7" step="1" id="sl-s" oninput="live()"><span class="sl-val" id="v-s">7</span></div>'+
      '<div class="toggle-section">'+
        '<div class="num-row"><div class="num-label"><span class="dot" style="background:'+CH+'"></span>Ayuno (horas)</div><input type="number" class="num-input" id="inp-a" min="0" max="24" value="16"></div>'+
        '<div class="num-row"><div class="num-label"><span class="dot" style="background:'+CP+'"></span>Lectura (min)</div><input type="number" class="num-input" id="inp-l" min="0" max="120" value="20"></div>'+
        '<div class="tog-row"><div class="tog-info"><span class="dot" style="background:'+CK+'"></span><div><div class="tog-name">Entrene hoy</div><div class="tog-sub">HIIT / combate / fuerza</div></div></div><label class="switch"><input type="checkbox" id="t-en" onchange="live()"><span class="sw-track"></span></label></div>'+
        '<div class="tog-row"><div class="tog-info"><span class="dot" style="background:'+CH+'"></span><div><div class="tog-name">Ducha fria</div><div class="tog-sub">Minimo 2 minutos</div></div></div><label class="switch"><input type="checkbox" id="t-fr" onchange="live()"><span class="sw-track"></span></label></div>'+
        '<div class="tog-row"><div class="tog-info"><span class="dot" style="background:'+CP+'"></span><div><div class="tog-name">Cierre nocturno</div><div class="tog-sub">Oscuridad antes de las 22h</div></div></div><label class="switch"><input type="checkbox" id="t-ci" onchange="live()"><span class="sw-track"></span></label></div>'+
      '</div>'+
      '<button class="btn-save" id="btn-save" onclick="guardar()">Guardar registro</button>'+
    '</div>'
  )+
  '<div class="card">'+
    '<div class="card-title">Estado de ejes</div>'+
    '<div class="eje-row"><span class="eje-letter" style="color:'+CH+'">H</span><div class="eje-body"><div class="eje-head"><span class="eje-name">Hormonal</span><span class="eje-pct" style="color:'+CH+'" id="pct-h">'+ejH+'%</span></div><div class="eje-track"><div class="eje-fill" id="bar-h" style="width:'+ejH+'%;background:'+CH+'"></div></div></div></div>'+
    '<div class="eje-row"><span class="eje-letter" style="color:'+CP+'">P</span><div class="eje-body"><div class="eje-head"><span class="eje-name">Psico-cognitivo</span><span class="eje-pct" style="color:'+CP+'" id="pct-p">'+ejP+'%</span></div><div class="eje-track"><div class="eje-fill" id="bar-p" style="width:'+ejP+'%;background:'+CP+'"></div></div></div></div>'+
    '<div class="eje-row"><span class="eje-letter" style="color:'+CK+'">K</span><div class="eje-body"><div class="eje-head"><span class="eje-name">Kinetico</span><span class="eje-pct" style="color:'+CK+'" id="pct-k">'+ejK+'%</span></div><div class="eje-track"><div class="eje-fill" id="bar-k" style="width:'+ejK+'%;background:'+CK+'"></div></div></div></div>'+
    renderChart(historial)+
  '</div>'+
  '<div class="card"><div class="card-title">Protocolo hoy</div>'+renderProto()+'</div>';

  live();
}

function live(){
  var e=gv("sl-e"),f=gv("sl-f"),h=gv("sl-h"),s=gv("sl-s");
  var ay=gn("inp-a"),lec=gn("inp-l");
  var en=gc("t-en"),fr=gc("t-fr"),ci=gc("t-ci");
  st("v-e",e);st("v-f",f);st("v-h",h);st("v-s",s);
  var ejH=Math.min(100,Math.round((e*0.35+h*0.30+Math.min(s,10)*0.20+Math.min(ay/2,10)*0.15)*10));
  var ejP=Math.min(100,Math.round((f*0.50+Math.min(lec/6,10)*0.30+h*0.20)*10));
  var ejK=Math.round(((en?10:0)*0.40+(fr?10:0)*0.30+(ci?10:0)*0.30)*10);
  var sc=((ejH/10+ejP/10+ejK/10)/3).toFixed(1);
  setBar("bar-h","pct-h",ejH);
  setBar("bar-p","pct-p",ejP);
  setBar("bar-k","pct-k",ejK);
  st("score-live",sc);
}

function guardar(){
  var btn=document.getElementById("btn-save");
  if(!btn)return;
  btn.disabled=true;
  btn.textContent="Guardando...";
  google.script.run
    .withSuccessHandler(function(res){
      if(res.ok){
        btn.textContent="Guardado";
        btn.classList.add("ok");
        toast("Registro guardado. Huella permanente.","ok");
        setTimeout(function(){
          google.script.run
            .withSuccessHandler(function(data){estado=data;render();})
            .getEstado();
        },1400);
      } else {
        btn.disabled=false;
        btn.textContent="Guardar registro";
        toast(res.msg,"err");
      }
    })
    .withFailureHandler(function(){
      btn.disabled=false;
      btn.textContent="Guardar registro";
      toast("Error de conexion","err");
    })
    .guardarRegistro({
      energia:gv("sl-e"),humor:gv("sl-h"),sueno:gv("sl-s"),foco:gv("sl-f"),
      ayuno:gn("inp-a"),lectura:gn("inp-l"),
      entreno:gc("t-en"),frio:gc("t-fr"),cierre:gc("t-ci")
    });
}

function renderProto(){
  var items=[
    {c:CH,n:"Ayuno activo hasta las 12h",w:"GLP-1 + dopamina matutina"},
    {c:CK,n:"HIIT 25 min - rounds 40/20",w:"GLP-1 endogeno + noradrenalina"},
    {c:CP,n:"Lectura 20 min post-entreno",w:"BDNF elevado - aprendizaje acelerado"},
    {c:CH,n:"Ducha fria 2 min",w:"Noradrenalina + dopamina 2-3h"},
    {c:CP,n:"Registra antes de las 23:59",w:"Registro inmutable - huella real"},
    {c:CK,n:"Cierre: oscuridad a las 22h",w:"Melatonina + GH nocturna"}
  ];
  return items.map(function(i){
    return '<div class="proto-item"><div class="proto-dot" style="background:'+i.c+'"></div><div><div class="proto-name">'+i.n+'</div><div class="proto-why">'+i.w+'</div></div></div>';
  }).join("");
}

function renderChart(h){
  if(!h||h.length<2)return "";
  var bars=h.map(function(d){
    var pct=Math.round(((d.score||0)/10)*100);
    var col=d.score>=7?CK:d.score>=5?CS:CH;
    return '<div class="chart-bar" style="height:'+pct+'%;background:'+col+';opacity:0.7"></div>';
  }).join("");
  var dates=h.map(function(d){
    var dt=new Date(d.fecha+"T00:00:00");
    return '<div class="chart-date">'+dt.getDate()+"/"+(dt.getMonth()+1)+'</div>';
  }).join("");
  return '<div class="chart-wrap"><div class="chart-eyebrow">Ultimos '+h.length+' dias</div><div class="chart-bars">'+bars+'</div><div class="chart-dates">'+dates+'</div></div>';
}

function gv(id){var el=document.getElementById(id);return el?Number(el.value):0;}
function gn(id){var el=document.getElementById(id);return el?Number(el.value)||0:0;}
function gc(id){var el=document.getElementById(id);return el?el.checked:false;}
function st(id,val){var el=document.getElementById(id);if(el)el.textContent=val;}
function setBar(bid,pid,pct){
  var b=document.getElementById(bid),p=document.getElementById(pid);
  if(b)b.style.width=Math.min(pct,100)+"%";
  if(p)p.textContent=Math.min(pct,100)+"%";
}
function toast(msg,type){
  var t=document.getElementById("toast");
  t.textContent=msg;
  t.className="toast show "+(type||"");
  setTimeout(function(){t.className="toast";},3200);
}
</script>
</body>
</html>
